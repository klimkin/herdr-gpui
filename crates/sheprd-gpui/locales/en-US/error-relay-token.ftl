# Why a private relay's listen token could not be checked or kept, in
# Settings > Remote control and `sheprd remote relays token`.

error-relay-token-answer = The relay's answer is not one a relay gives.
error-relay-token-endpoint = That is not a relay address.
# $error is the network library's own reason.
error-relay-token-info = The relay did not answer: { $error }
# $protocol is a number.
error-relay-token-protocol = The relay speaks protocol { $protocol }, which this Sheprd does not.
